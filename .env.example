# ============================================================
# CONFIGURACIÓN DE ENTORNO PARA NUEVO DOMINIO
# Copia este archivo como .env en la raíz de tu servidor
# ============================================================

# 1. Base de Datos (Hostinger / cPanel / Local)
DB_HOST=localhost
DB_NAME=nombre_de_tu_base_de_datos
DB_USER=usuario_de_tu_base_de_datos
DB_PASS=tu_contraseña_segura

# 2. Dominio y Nombre de la Empresa
# (Opcional: Si se deja vacío, el sistema lo detecta automáticamente)
SITE_URL=https://tu-nuevo-dominio.com
SITE_NAME=Tu Barbería

# 3. Google OAuth para Login de Clientes (Opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Google reCAPTCHA v2 / v3
RECAPTCHA_SITE_KEY=6Ldm9oUtAAAAALygbin3zWA6sx15vHe7DeJ0-Rop
RECAPTCHA_SECRET_KEY=6Ldm9oUtAAAAAItTxMMq49FFc2Gl76ppbDsJfBIU

# 5. Clave de Seguridad para Cron Jobs
CRON_SECRET=KortzenCron2026_9b8a7c6e5f4d
